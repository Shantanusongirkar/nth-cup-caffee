# PostgreSQL / Neon connection string. Example for Neon:
# postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://..."

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys).
# Use test-mode keys for development.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Razorpay webhook signature secret (Dashboard -> Settings -> Webhooks -> your
# webhook -> Secret). Required for embedded UPI QR payment confirmation.
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# Visible UPI QR countdown in seconds (default 300). The Razorpay `close_by`
# always stays >= 15 min ahead; the server closes the QR at visible expiry.
UPI_QR_TTL_SECONDS="300"

# Dev-only mock UPI QR + payment simulator. Enables clearly-fake test QRs and
# POST /api/dev/simulate-upi-payment for local testing without real money.
# Only honoured when NODE_ENV=development. Keep "false" (or unset) otherwise.
ENABLE_DEV_PAYMENT_SIMULATOR="true"

# Vercel Blob (https://vercel.com -> Storage -> your Blob store -> Settings).
# Required for admin product image uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"